rules_version = '2';

/**
 * Kaizen Budget — Firestore security rules
 *
 * Data layout (matches the React app):
 *   users/{userId}/accounts/{accountId}
 *   users/{userId}/transactions/{transactionId}
 *   users/{userId}/categories/{categoryId}
 *   users/{userId}/scheduledTransactions/{id}  — one-time or recurring templates
 *
 * Only the signed-in user whose UID equals {userId} may read/write these paths.
 * The parent document users/{userId} is not used by the app and is locked down.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Optional ISO currency on accounts/categories/transactions (app: USD, XCD). */
    function optionalCurrencyOk() {
      let d = request.resource.data;
      return !d.keys().hasAny(['currency'])
        || (d.currency is string && d.currency in ['USD', 'XCD']);
    }

    /** Accounts: name + balance; optional currency */
    function validAccountWrite() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'balance'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() < 200
        && d.balance is number
        && optionalCurrencyOk();
    }

    /**
     * Categories:
     *   income  -> { name, kind: "income" } [+ optional currency]
     *   expense -> { name, budget } or { name, budget, kind: "expense" } [+ optional currency]
     */
    function validCategoryWrite() {
      let d = request.resource.data;
      return (d.name is string && d.name.size() > 0 && d.name.size() < 200)
        && optionalCurrencyOk()
        && (
          (d.kind == 'income'
            && d.keys().hasAll(['name', 'kind'])
            && d.keys().hasOnly(['name', 'kind', 'currency']))
          || (
            d.keys().hasAll(['budget'])
            && (d.budget is number)
            && d.budget >= 0
            && (
              (d.keys().hasOnly(['name', 'budget'])
                || d.keys().hasOnly(['name', 'budget', 'currency']))
              || (
                d.kind == 'expense'
                && d.keys().hasAll(['name', 'budget', 'kind'])
                && (
                  d.keys().hasOnly(['name', 'budget', 'kind'])
                  || d.keys().hasOnly(['name', 'budget', 'kind', 'currency'])
                )
              )
            )
          )
        );
    }

    /** Full transaction document shape (create + update merge result). */
    function validTransactionDocument() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'desc',
          'amount',
          'type',
          'category',
          'accountId',
          'createdAt'
        ])
        && d.desc is string
        && d.desc.size() < 500
        && d.amount is number
        && d.amount >= 0
        && d.type is string
        && (d.type == 'income' || d.type == 'expense')
        && d.category is string
        && d.category.size() > 0
        && d.category.size() < 200
        && d.accountId is string
        && d.accountId.size() > 0
        && d.createdAt is timestamp
        && optionalCurrencyOk();
    }

    /** Scheduled / recurring transaction templates (client applies due items on load). */
    function validScheduledDocument() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'desc',
          'amount',
          'type',
          'category',
          'accountId',
          'scheduleType',
          'nextRunAt',
          'enabled',
          'createdAt'
        ])
        && d.desc is string
        && d.desc.size() > 0
        && d.desc.size() < 500
        && d.amount is number
        && d.amount >= 0
        && d.type is string
        && (d.type == 'income' || d.type == 'expense')
        && d.category is string
        && d.category.size() > 0
        && d.category.size() < 200
        && d.accountId is string
        && d.accountId.size() > 0
        && d.scheduleType is string
        && (d.scheduleType == 'once' || d.scheduleType == 'recurring')
        && d.nextRunAt is timestamp
        && d.enabled is bool
        && d.createdAt is timestamp
        && optionalCurrencyOk()
        && (!d.keys().hasAny(['lastRunAt']) || d.lastRunAt is timestamp)
        && (
          (d.scheduleType == 'once' && !d.keys().hasAny(['frequency']))
          || (
            d.scheduleType == 'recurring'
            && d.keys().hasAll(['frequency'])
            && d.frequency is string
            && d.frequency in ['daily', 'weekly', 'monthly']
          )
        );
    }

    /* No direct access to the user root document (subcollections still work). */
    match /users/{userId} {
      allow read, write: if false;
    }

    match /users/{userId}/accounts/{accountId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validAccountWrite();
      allow update: if isOwner(userId) && validAccountWrite();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/categories/{categoryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validCategoryWrite();
      allow update: if isOwner(userId) && validCategoryWrite();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/transactions/{transactionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validTransactionDocument();
      /* Edits in TransactionList; category renames batch-update category only. */
      allow update: if isOwner(userId) && validTransactionDocument();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/scheduledTransactions/{scheduledId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validScheduledDocument();
      allow update: if isOwner(userId) && validScheduledDocument();
      allow delete: if isOwner(userId);
    }

    /* Deny everything else by default. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
